# ============================================================================
# 115emby 配置示例
# 复制成 .env 再改：  cp .env.example .env
# ============================================================================

# ============ 一、路径与运行时 ============
# 所有运行期数据（索引库 / 缩略图库 / 口令文件）都在 DATA_DIR 下，务必备份
DATA_DIR=/app/data
EMBY_DB=/app/data/emby.db
THUMB_DB=/app/data/thumbs.db
# 日志级别：debug / info / warning / error
LOG_LEVEL=warning
# 前端静态目录（一般不用改）
# STATIC_DIR=/app/app/static

# ============ 二、首次部署与访问控制 ============
# 站点口令**不在这里配**：第一次打开网页时会在页面上让你设置（至少 8 位）。
# 觉得"谁先打开谁就能设"不安全的话，设一个部署口令（见下）：
#
# 设了 SETUP_TOKEN 之后，首次设置口令的表单会多出一个「部署口令」输入框，
# 必须填对才能设置。公开到公网时**强烈建议设置**。
SETUP_TOKEN=
#
# 后台 /admin 的口令（与服务端 ADMIN_TOKEN 比较，走请求头 X-Admin-Token）。
# 留空则关闭后台的令牌入口（仍可用站点管理员账号登录后台）。
ADMIN_TOKEN=
# 口令文件位置（默认 DATA_DIR/site_auth.json）
# SITE_AUTH_FILE=/app/data/site_auth.json

# ============ 三、115 凭据（三种任选，优先 cookie）============
# 1) 网页版 Cookie（最常用）：浏览器登录 115 后复制整条 Cookie
COOKIE_115=
# 2) 开放平台 access_token（有效期较长）
ACCESS_TOKEN_115=
# 3) 开放平台 PKCE 设备码登录用的 client_id（公开客户端，无需 secret）
APP_ID_115=
OAUTH_SCOPE_115=files.read photo.read video.read user.read
PASSPORT_BASE_115=https://passportapi.115.com
QRCODE_BASE_115=https://qrcodeapi.115.com
API_BASE_115=https://webapi.115.com
PRO_APP_BASE_115=https://proapi.115.com
APP_BASE_115=https://appapi.115.com

# 调 115 接口用的 UA
UA=Mozilla/5.0 115Browser/27.0.5.7
# ---------------------------------------------------------------------------
# 取流/抓帧必须用**浏览器 UA**：115 的 CDN 会 403 掉 "115Browser/..." 这类客户端 UA。
# 同一个文件，浏览器 UA / VLC / 空 UA 取都是 206，115Browser UA 一律 403；
# 且用该 UA 签发的直链对任何取流 UA 都是 403。所以两个 UA 不能混。
CDN_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36
# 客户端 UA 里带 115Browser 时，/p/<token> 会走"换个浏览器"说明页（CDN 端拒了）
PASS_BLOCKED_UA_RE=115browser

# ============ 四、上游节流（与生产相册共用同一 115 账号时**勿改小**）============
# 两次上游请求最小间隔（秒）。0.4 已偏激进，1.0 最稳
API_MIN_INTERVAL=1.0
# 同时在飞的上游请求数
API_CONCURRENCY=2
# 每 N 次调用整体休息
PREFETCH_REST_EVERY=200
PREFETCH_REST_SECONDS=5

# ============ 五、扫描 ============
# 扫描根目录（不配则在后台「扫描目录」里添加）
ROOTS_FILE=/app/data/scan_roots.json
SCAN_STATE_FILE=/app/data/scan_state.json
# 每页拉多少个条目（115 单页上限 1150 左右）
SCAN_PAGE_LIMIT=1000
SCAN_MAX_PAGES=2000
# 增量扫描
SCAN_INCREMENTAL=1
SCAN_SKIP_WITHIN_S=300
# 快扫（只读目录树不读文件）
FAST_SCAN_CONCURRENCY=3
FAST_SCAN_INTERVAL=0.35
FAST_SCAN_LOOKAHEAD=40
# 首页/根目录（后台设置里配了就以后台为准）
HOME_CID=
HOME_NAME=

# ============ 六、缩略图 ============
THUMB_SIZE=384
THUMB_QUALITY=78
# 单张上游缩略图体积上限（字节），超过直接跳过，避免"为缩略图拉原图"
THUMB_MAX_BYTES=307200
# 原图转缩略图时的读取上限
THUMB_ORIGIN_MAX_BYTES=8388608
# 内存 LRU（MB）
THUMB_LRU_MB=32
# 生成缩略图的并发（2C 机器别给大）
THUMB_ENCODE_CONCURRENCY=2
THUMB_IMG_CONCURRENCY=2
THUMB_IMG_MIN_INTERVAL=0.35
# 同一份小图重复出现多少次判定为占位图（115 的"图片已过期"）
THUMB_PLACEHOLDER_REPEAT=5
# 出图接口的服务端并发与后台预取
THUMB_CONCURRENCY=6
THUMB_BG_MAX=2
THUMB_RELIST_COOLDOWN_S=90
# 小于这个字节数的图片不显示（二维码、1px 占位图之类）
MIN_IMAGE_BYTES=30000

# ============ 七、夜间预热（定时抓缩略图）============
# 0 = 只懒抓（推荐先这样跑一周，看真实访问分布再开）
THUMB_PREWARM_ENABLED=0
# 时间窗：02:00-06:00；跨零点写 23:00-05:00；起止相同=全天
THUMB_PREWARM_WINDOW=02:00-06:00
# 每夜上限；0 = 按「窗口分钟 ÷ API_MIN_INTERVAL」自动推算
THUMB_PREWARM_MAX_PER_NIGHT=0
THUMB_PREWARM_RETRY_HOURS=6
THUMB_PREWARM_MAX_ATTEMPTS=3
THUMB_PREWARM_TICK=30

# ============ 八、视频抓帧（115 不给视频封面，只能自己抓）============
VIDEO_THUMB_ENABLED=1
# ffmpeg 允许读的字节上限（只读头部，不下载整段视频）
VIDEO_THUMB_BYTES=3145728
# 取第几秒的帧（避开片头黑屏）
VIDEO_THUMB_SEEK=1.0
VIDEO_THUMB_TIMEOUT=45
# 解码线程数（2C 机器别给大）
VIDEO_THUMB_THREADS=2
VIDEO_THUMB_SIZE=384
# 永不抓帧的扩展名（HLS 会拉多个分片，流量不可控）
VIDEO_THUMB_SKIP_EXTS=m3u8
# 低优先格式（ts/m2ts 无全局索引、rm/rmvb 老容器，可能读得比别的多）
VIDEO_THUMB_LOWPRIORITY_EXTS=ts,m2ts,mpg,rm,rmvb
VIDEO_THUMB_ALLOW_LOWPRIORITY=0
# 额外请求头（| 分隔），需要 Cookie 鉴权的源才用
VIDEO_THUMB_HEADERS=
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# ============ 九、加密密钥（三选一，从上到下优先级）============
# 1) 32 字节 hex 或 base64（推荐：用密码管理器/KMS 保存）
THUMB_ENC_KEY=
# 2) 口令 + 盐文件，PBKDF2-HMAC-SHA256 60 万轮
THUMB_ENC_PASSPHRASE=
THUMB_ENC_SALT_FILE=/app/data/.thumbsalt
# 3) 都不配 → 本机随机 DATA_DIR/.thumbkey
#    会告警：密钥与密文同盘，只能防"文件被单独拷走"
THUMB_ENC_KEYS_FILE=/app/data/.thumbkey

# ============ 十、内容过滤 ============
# 命中关键词的条目不进列表（逗号分隔）
HIDE_KEYWORDS=
# 按域名规则过滤
HIDE_DOMAIN_RULE=
# 广告词
HIDE_AD_WORDS=
# 过滤哪些类型（默认只过滤视频）
HIDE_KINDS=video
# 小于这个体积的视频判为广告短片
HIDE_VIDEO_MAX_BYTES=0

# ============ 十一、其它 ============
# 外链播放 token 的签名密钥（不配则随机生成，重启后旧 token 失效）
HANDOFF_SECRET=
HANDOFF_TTL=86400
# HLS 代理（桌面端浏览器播 m3u8 用）
HLS_PROXY_ENABLED=1
# 随机发现每个目录参与随机的窗口（越大覆盖越全、越慢）
DISCOVER_WIN=200
# 搜索索引缓存条数与秒数
SEARCH_INDEX_MAX=200000
SEARCH_INDEX_TTL=600

# 小内存机器建议（Dockerfile 里已设）
MALLOC_ARENA_MAX=2
PYTHONUNBUFFERED=1
